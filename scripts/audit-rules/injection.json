  {
   "id": "JZ-WEAKID-001",
   "title": "可预测的会话/令牌标识",
   "kind": "pattern",
   "severity": "medium",
   "confidence_base": 0.6,
   "languages": [
    "php",
    "python",
    "javascript",
    "ruby"
   ],
   "cwe": [
    "CWE-330",
    "CWE-338"
   ],
   "owasp": [
    "A07:2021 认证失效"
   ],
   "sinks": [
    {
     "pattern": "\\b(?:md5|sha1|crc32)\\s*\\(\\s*(?:time|microtime|mt_rand|rand|uniqid)\\s*\\("
    },
    {
     "pattern": "\\$_SESSION\\s*\\[[^\\]]*\\]\\s*\\+\\+"
    },
    {
     "pattern": "\\bmd5\\s*\\(\\s*\\$_SESSION"
    },
    {
     "pattern": "(?i)\\$(?:cookie_value|session_?\\w*|token|nonce)\\w*\\s*=\\s*(?:time|rand|mt_rand|uniqid|microtime)\\s*\\(?|\\b(?:cookie_value|session_id|token|nonce)\\s*=\\s*(?:time|rand|Math\\.random)\\s*\\(??"
    }
   ],
   "unless_present": [
    {
     "pattern": "random_bytes|openssl_random_pseudo_bytes|secrets\\.|crypto\\.randomBytes|random_int|SecureRandom",
     "window": 6
    }
