   ],
   "sanitizers": [
    {
     "pattern": "\\bshlex\\.quote\\b|\\bescapeshellarg\\b|\\bsubprocess\\.\\w+\\s*\\(\\s*\\["
    },
    {
     "pattern": "\\b(?:intval|floatval|settype|is_numeric)\\s*\\("
    }
   ],
   "fix": "不经过 shell：subprocess.run([\"convert\", src, dst], shell=False)；必须拼接时逐个参数 shlex.quote / escapeshellarg，命令名固定不来自输入。",
   "retest": "输入 a; id 与 a$(id)：修复前会额外执行命令（返回 uid 或生成副作用文件），修复后应把整串当文件名而报错。"
  },
