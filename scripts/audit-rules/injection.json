{
 "schema": "jiangzuo-audit-rules/1",
 "name": "injection",
 "rules": [
  {
   "id": "JZ-SQLI-001",
   "title": "SQL 字符串拼接/插值（Python）",
   "kind": "taint",
   "severity": "critical",
   "confidence_base": 0.6,
   "languages": [
    "python"
   ],
   "cwe": [
    "CWE-89"
   ],
   "owasp": [
    "A03:2021 注入"
   ],
   "sinks": [
    {
     "pattern": "\\b(?:execute|executemany|raw|query|text)\\s*\\(\\s*f[\"']"
    },
    {
     "pattern": "\\b(?:execute|executemany|raw|query)\\s*\\([^)\\n]*(?:%\\s*\\(|%\\s*[\"']|\\.format\\s*\\(|\\+\\s*[A-Za-z_(]|\\bjoin\\s*\\()"
    },
    {
     "pattern": "\\b(?:cursor|db|session|engine)\\s*\\.\\s*(?:execute|query)\\s*\\([^)\\n]*[\"'][^)\"']*[\"']\\s*\\+"
    }
   ],
   "sources": [
    {
     "pattern": "\\brequest\\.(?:args|form|json|values|query_string|data)\\b"
    },
    {
     "pattern": "\\breq\\.(?:body|query|params)\\b|\\bparams\\[|\\bargv\\["
    },
    {
     "pattern": "\\binput\\s*\\("
    }
   ],
   "sanitizers": [
    {
     "pattern": "\\b(?:execute|executemany)\\s*\\([^)]*,\\s*[\\[(]"
    },
    {
     "pattern": "\\b(?:parametrize|bindparam)\\b"
    },
    {
     "pattern": "\\b(?:int|float)\\s*\\("
    }
   ],
   "fix": "改成参数化查询：cursor.execute(\"SELECT * FROM t WHERE id=%s\", (user_id,))。拼接表名/列名/排序字段时改用白名单映射表——参数化管不了这些位置。",
   "retest": "给该参数传 1' OR '1'='1 与 1'; DROP TABLE--，确认返回 400/空结果而不是全表数据或 500；对照修复前后的 SQL 日志确认值进了占位符。"
  },
  {
   "id": "JZ-SQLI-002",
   "title": "SQL 模板字符串拼接（JS/TS）",
   "kind": "taint",
   "severity": "critical",
   "confidence_base": 0.6,
   "languages": [
    "javascript",
    "typescript"
   ],
   "cwe": [
    "CWE-89"
   ],
   "owasp": [
    "A03:2021 注入"
   ],
   "sinks": [
    {
     "pattern": "\\b(?:query|raw|execute)\\s*\\(\\s*[`\\\"'][^`\\\"']*\\$\\{"
    },
    {
     "pattern": "\\b(?:query|raw|execute)\\s*\\([^)\\n]*(?:\\+\\s*[A-Za-z_(]|\\bconcat\\s*\\(|\\.join\\s*\\()"
    }
   ],
   "sources": [
    {
     "pattern": "\\breq\\.(?:body|query|params)\\b"
    },
    {
     "pattern": "\\b(?:params|body)\\["
    }
   ],
   "sanitizers": [
    {
     "pattern": "\\$\\d+\\b"
    },
    {
     "pattern": "\\bescapeIdentifier\\b|\\bNumber\\s*\\(|\\bparseInt\\s*\\("
    }
   ],
   "fix": "用参数化：db.query('SELECT * FROM t WHERE id = $1', [id]) 或 db.query('... WHERE id = ?', [id])；动态列名走白名单。",
   "retest": "输入 ' OR 1=1 -- 确认查不到别人的数据；把值改到参数数组里，观察 SQL 是否仍含插值。"
  },
  {
   "id": "JZ-SQLI-003",
   "title": "SQL 拼接（Java/PHP/Ruby/Go）",
   "kind": "taint",
   "severity": "critical",
   "confidence_base": 0.55,
   "languages": [
    "java",
    "php",
    "ruby",
    "go"
   ],
   "cwe": [
    "CWE-89"
   ],
   "owasp": [
    "A03:2021 注入"
   ],
   "sinks": [
    {
     "pattern": "\\b(?:createQuery|createNativeQuery|prepareStatement|executeQuery)\\s*\\([^)]*\\+"
    },
    {
     "pattern": "(?:->query|::select|::raw|DB\\.Raw|db\\.Raw|mysql_query|mysqli_query)\\s*\\([^)]*(?:\\+|\\.\\s*[\"']|\\.\\s*\\$|\\$\\{|%s)"
    },
    {
     "pattern": "\\b(?:where|select|find_by_sql)\\s*\\(\\s*[\"'][^\"']*[\"']\\s*(?:\\+|#\\{)"
    },
    {
     "pattern": "(?:mysql_query|mysqli_query|pg_query|->query|->prepare|->exec)\\s*\\([^)]*\\$"
    }
   ],
   "sources": [
    {
     "pattern": "(?<!\\w)(?:request\\.getParameter|\\$_(?:GET|POST|REQUEST)|params\\[|c\\.Param)"
    },
    {
     "pattern": "file_get_contents\\s*\\(\\s*['\"]php://input['\"]"
    }
   ],
   "sanitizers": [
    {
     "pattern": "\\b(?:setString|setInt|bindValue)\\s*\\(|\\breal_escape_string\\b|\\bPreparedStatement\\b|\\$\\d"
    },
    {
     "pattern": "\\b(?:intval|floatval|settype|is_numeric|filter_var)\\s*\\("
    }
   ],
   "fix": "改用 PreparedStatement / ORM 参数绑定：Java prepareStatement(sql) 后 setString(1, v)；PHP 用 PDO 预处理；Ruby 用 where(\"id = ?\", id)；Go 用 db.Query(\"... $1\", v)。",
   "retest": "注入串单引号：修复前会报数据库语法错（说明值拼进了语句），修复后应得到类型校验错误且不落库。"
  },
  {
